{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A project managed by the application.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["RD", "DELIVERY"] },
        "status": { "type": "string", "enum": ["PLANNED", "ACTIVE", "COMPLETED", "ON_HOLD"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "lifecycle": { "type": "string", "enum": ["IDEA", "POC", "MVP", "DELIVERY"] },
        "rdCategory": { "type": "string", "enum": ["COLD", "HOT"] },
        "client": { "type": "string" },
        "startDate": { "type": "string" },
        "targetGoLive": { "type": "string" },
        "ownerId": { "type": "string" },
        "meetingAttendance": { "type": "string" },
        "meetingDate": { "type": "string" },
        "meetingOwner": { "type": "string" },
        "meetingSummary": { "type": "string" },
        "requirementData": { "type": "string" },
        "scopeOfWork": { "type": "string" },
        "useCases": { "type": "string" },
        "customer": { "type": "string" },
        "projectManager": { "type": "string" },
        "sponsor": { "type": "string" },
        "purpose": { "type": "string" },
        "objectives": { "type": "string" },
        "inScope": { "type": "string" },
        "outScope": { "type": "string" },
        "approvalStatus": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "approvalDate": { "type": "string" },
        "approverName": { "type": "string" }
      },
      "required": ["id", "name", "type", "status", "createdAt", "updatedAt", "ownerId"]
    },
    "Task": {
      "title": "Task",
      "description": "A task within a project.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["BACKLOG", "TODO", "IN_PROGRESS", "DONE", "BLOCKED"] },
        "workstream": { "type": "string" },
        "owner": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "duration": { "type": "number" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "phase": { "type": "string" },
        "sprintId": { "type": "string" },
        "parentId": { "type": "string" },
        "comments": { "type": "string" },
        "momDetails": { "type": "string" }
      },
      "required": ["id", "projectId", "title", "status", "workstream", "owner"]
    },
    "Sprint": {
      "title": "Sprint",
      "description": "A sprint within an Agile project.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "name": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string", "enum": ["PLANNED", "ACTIVE", "COMPLETED"] },
        "goal": { "type": "string" }
      },
      "required": ["id", "projectId", "name", "startDate", "endDate", "status"]
    },
    "RAIDItem": {
      "title": "RAIDItem",
      "description": "A Risk, Assumption, Dependency, or Issue.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "type": { "type": "string", "enum": ["RISK", "ASSUMPTION", "DEPENDENCY", "ISSUE"] },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "impact": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "probability": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "owner": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "CLOSED", "MITIGATED"] },
        "mitigation": { "type": "string" }
      },
      "required": ["id", "projectId", "type", "category", "description", "impact", "owner", "status", "mitigation"]
    },
    "Milestone": {
      "title": "Milestone",
      "description": "A project milestone.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "name": { "type": "string" },
        "phase": { "type": "string" },
        "targetDate": { "type": "string" },
        "status": { "type": "string", "enum": ["PLANNED", "ACHIEVED", "DELAYED"] }
      },
      "required": ["id", "projectId", "name", "phase", "targetDate", "status"]
    },
    "Phase": {
      "title": "Phase",
      "description": "A project phase for the roadmap.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "order": { "type": "number" },
        "color": { "type": "string" }
      },
      "required": ["id", "projectId", "name", "startDate", "endDate", "order"]
    },
    "DesignDoc": {
      "title": "DesignDoc",
      "description": "A design document (HLD or LLD).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "content": { "type": "string" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "projectId", "content", "updatedAt", "updatedBy"]
    },
    "ProjectFile": {
      "title": "ProjectFile",
      "description": "A file uploaded to a project document.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "docId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "size": { "type": "number" },
        "url": { "type": "string" },
        "uploadedAt": { "type": "number" }
      },
      "required": ["id", "projectId", "docId", "name", "type", "size", "url", "uploadedAt"]
    },
    "Resource": {
      "title": "Resource",
      "description": "Human resources available for projects.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "email": { "type": "string" },
        "department": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "availability": { "type": "number" },
        "projectIds": { "type": "array", "items": { "type": "string" } },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "role", "ownerId", "createdAt", "updatedAt"]
    },
    "ChangeRequest": {
      "title": "ChangeRequest",
      "description": "A change request for a delivery project.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "overview": { "type": "string" },
        "objective": { "type": "string" },
        "acceptanceCriteria": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "IMPLEMENTED"] },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "requestedBy": { "type": "string" },
        "requestedDate": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "projectId", "title", "overview", "objective", "acceptanceCriteria", "status", "priority", "requestedBy", "requestedDate", "createdAt", "updatedAt"]
    },
    "IssueLogItem": {
      "title": "IssueLogItem",
      "description": "An item in the dedicated Issue Log.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "status": { "type": "string", "enum": ["OPEN", "IN_PROGRESS", "RESOLVED", "CLOSED"] },
        "owner": { "type": "string" },
        "reportedBy": { "type": "string" },
        "reportedDate": { "type": "string" },
        "resolution": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "projectId", "title", "description", "priority", "status", "owner", "reportedBy", "reportedDate", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of projects."
    },
    "/projects/{projectId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks associated with a project."
    },
    "/projects/{projectId}/raidItems/{raidItemId}": {
      "schema": "RAIDItem",
      "description": "RAID items associated with a project."
    },
    "/projects/{projectId}/milestones/{milestoneId}": {
      "schema": "Milestone",
      "description": "Milestones associated with a project."
    },
    "/projects/{projectId}/phases/{phaseId}": {
      "schema": "Phase",
      "description": "Phases associated with a project roadmap."
    },
    "/projects/{projectId}/sprints/{sprintId}": {
      "schema": "Sprint",
      "description": "Sprints associated with an Agile project."
    },
    "/projects/{projectId}/designDocs/{docId}": {
      "schema": "DesignDoc",
      "description": "Design documents (HLD/LLD) for a project."
    },
    "/projects/{projectId}/files/{fileId}": {
      "schema": "ProjectFile",
      "description": "Files uploaded to a project."
    },
    "/projects/{projectId}/changeRequests/{requestId}": {
      "schema": "ChangeRequest",
      "description": "Change requests associated with a project."
    },
    "/projects/{projectId}/issueLogItems/{itemId}": {
      "schema": "IssueLogItem",
      "description": "Items in the dedicated Issue Log."
    },
    "/resources/{resourceId}": {
      "schema": "Resource",
      "description": "Collection of human resources."
    }
  }
}
