rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: projects
    // Document ID: projectId
    // Fields:
    //   - id: string (required)
    //   - name: string (required, size < 100)
    //   - description: string (optional, size < 1000)
    //   - type: string (required, enum: ["RD", "DELIVERY"])
    //   - status: string (required, enum: ["PLANNED", "ACTIVE", "COMPLETED", "ON_HOLD"])
    //   - createdAt: number (required)
    //   - updatedAt: number (required)
    //   - lifecycle: string (optional, enum: ["IDEA", "POC", "MVP", "DELIVERY"])
    //   - rdCategory: string (optional, enum: ["COLD", "HOT"])
    //   - client: string (optional, size < 100)
    //   - startDate: string (optional, ISO 8601)
    //   - targetGoLive: string (optional, ISO 8601)
    //   - ownerId: string (required, matches auth.uid)
    //   - customer: string (optional)
    //   - projectManager: string (optional)
    //   - sponsor: string (optional)
    //   - purpose: string (optional)
    //   - objectives: string (optional)
    //   - inScope: string (optional)
    //   - outScope: string (optional)
    //   - approvalStatus: string (optional, enum: ["PENDING", "APPROVED", "REJECTED"])
    //   - approvalDate: string (optional)
    //   - approverName: string (optional)
    //
    // Sub-collection: tasks
    // Fields:
    //   - id: string (required)
    //   - projectId: string (required)
    //   - title: string (required, size < 200)
    //   - description: string (optional, size < 1000)
    //   - status: string (required, enum: ["BACKLOG", "TODO", "IN_PROGRESS", "DONE", "BLOCKED"])
    //   - workstream: string (required, size < 100)
    //   - owner: string (required, size < 100)
    //   - startDate: string (optional)
    //   - endDate: string (optional)
    //   - duration: number (optional)
    //   - dependencies: list (optional, size < 50)
    //   - phase: string (optional, size < 100)
    //
    // Sub-collection: raidItems
    // Fields:
    //   - id: string (required)
    //   - projectId: string (required)
    //   - type: string (required, enum: ["RISK", "ASSUMPTION", "DEPENDENCY", "ISSUE"])
    //   - category: string (required, size < 100)
    //   - description: string (required, size < 1000)
    //   - impact: string (required, enum: ["LOW", "MEDIUM", "HIGH"])
    //   - probability: string (optional, enum: ["LOW", "MEDIUM", "HIGH"])
    //   - owner: string (required, size < 100)
    //   - status: string (required, enum: ["OPEN", "CLOSED", "MITIGATED"])
    //   - mitigation: string (required, size < 1000)
    //
    // Sub-collection: milestones
    // Fields:
    //   - id: string (required)
    //   - projectId: string (required)
    //   - name: string (required, size < 200)
    //   - phase: string (required, size < 100)
    //   - targetDate: string (required)
    //   - status: string (required, enum: ["PLANNED", "ACHIEVED", "DELAYED"])
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((request.auth.token.email == "ahmed.n.abdelkarim17@gmail.com" && request.auth.token.email_verified == true) ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isProjectOwner(projectId) {
      return isAuthenticated() && 
        (isAdmin() || 
         (exists(/databases/$(database)/documents/projects/$(projectId)) && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid) ||
         (getAfter(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid));
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'name', 'type', 'status', 'createdAt', 'updatedAt', 'ownerId']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.type in ["RD", "DELIVERY"] &&
             data.status in ["PLANNED", "ACTIVE", "COMPLETED", "ON_HOLD"] &&
             data.createdAt is number &&
             data.updatedAt is number &&
             (!('rdCategory' in data) || data.rdCategory in ["COLD", "HOT"]) &&
             (!('meetingAttendance' in data) || (data.meetingAttendance is string && data.meetingAttendance.size() < 2000)) &&
             (!('meetingDate' in data) || (data.meetingDate is string && data.meetingDate.size() < 100)) &&
             (!('meetingOwner' in data) || (data.meetingOwner is string && data.meetingOwner.size() < 200)) &&
             (!('meetingSummary' in data) || (data.meetingSummary is string && data.meetingSummary.size() < 5000)) &&
             (!('customer' in data) || (data.customer is string && data.customer.size() < 200)) &&
             (!('projectManager' in data) || (data.projectManager is string && data.projectManager.size() < 200)) &&
             (!('sponsor' in data) || (data.sponsor is string && data.sponsor.size() < 200)) &&
             (!('purpose' in data) || (data.purpose is string && data.purpose.size() < 5000)) &&
             (!('objectives' in data) || (data.objectives is string && data.objectives.size() < 5000)) &&
             (!('inScope' in data) || (data.inScope is string && data.inScope.size() < 5000)) &&
             (!('outScope' in data) || (data.outScope is string && data.outScope.size() < 5000)) &&
             (!('approvalStatus' in data) || data.approvalStatus in ["PENDING", "APPROVED", "REJECTED"]) &&
             (!('approvalDate' in data) || (data.approvalDate is string && data.approvalDate.size() < 100)) &&
             (!('approverName' in data) || (data.approverName is string && data.approverName.size() < 200)) &&
             (!('requirementData' in data) || (data.requirementData is string && data.requirementData.size() < 5000)) &&
             (!('scopeOfWork' in data) || (data.scopeOfWork is string && data.scopeOfWork.size() < 5000)) &&
             (!('useCases' in data) || (data.useCases is string && data.useCases.size() < 5000)) &&
             (data.ownerId == request.auth.uid || (isAdmin() && data.ownerId != null));
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'projectId', 'title', 'status', 'workstream', 'owner']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.status in ["BACKLOG", "TODO", "IN_PROGRESS", "DONE", "BLOCKED"] &&
             data.workstream is string && data.workstream.size() < 100 &&
             data.owner is string && data.owner.size() < 100 &&
             (!('sprintId' in data) || (data.sprintId is string && data.sprintId.size() < 50)) &&
             (!('parentId' in data) || (data.parentId is string && data.parentId.size() < 50)) &&
             (!('dependencies' in data) || (data.dependencies is list && data.dependencies.size() < 50)) &&
             (!('comments' in data) || (data.comments is string && data.comments.size() < 2000)) &&
             (!('momDetails' in data) || (data.momDetails is string && data.momDetails.size() < 5000));
    }

    function isValidSprint(data) {
      return data.keys().hasAll(['id', 'projectId', 'name', 'startDate', 'endDate', 'status']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.startDate is string &&
             data.endDate is string &&
             data.status in ["PLANNED", "ACTIVE", "COMPLETED"] &&
             (!('goal' in data) || (data.goal is string && data.goal.size() < 500));
    }

    function isValidRAIDItem(data) {
      return data.keys().hasAll(['id', 'projectId', 'type', 'category', 'description', 'impact', 'owner', 'status', 'mitigation']) &&
             data.type in ["RISK", "ASSUMPTION", "DEPENDENCY", "ISSUE"] &&
             data.category is string && data.category.size() < 100 &&
             data.description is string && data.description.size() < 1000 &&
             data.impact in ["LOW", "MEDIUM", "HIGH"] &&
             data.owner is string && data.owner.size() < 100 &&
             data.status in ["OPEN", "CLOSED", "MITIGATED"] &&
             data.mitigation is string && data.mitigation.size() < 1000;
    }

    function isValidMilestone(data) {
      return data.keys().hasAll(['id', 'projectId', 'name', 'phase', 'targetDate', 'status']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.phase is string && data.phase.size() < 100 &&
             data.status in ["PLANNED", "ACHIEVED", "DELAYED"];
    }

    function isValidPhase(data) {
      return data.keys().hasAll(['id', 'projectId', 'name', 'startDate', 'endDate', 'order']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.startDate is string &&
             data.endDate is string &&
             data.order is number &&
             (!('description' in data) || (data.description is string && data.description.size() < 1000));
    }

    function isValidDesignDoc(data) {
      return data.keys().hasAll(['id', 'projectId', 'content', 'updatedAt', 'updatedBy']) &&
             data.id in ['hld', 'lld'] &&
             data.content is string &&
             data.updatedAt is number &&
             data.updatedBy is string;
    }

    function isValidProjectFile(data) {
      return data.keys().hasAll(['id', 'projectId', 'docId', 'name', 'type', 'size', 'url', 'uploadedAt']) &&
             data.name is string && data.name.size() > 0 &&
             data.type is string &&
             data.size is number &&
             data.url is string &&
             data.uploadedAt is number;
    }

    function isValidChangeRequest(data) {
      return data.keys().hasAll(['id', 'projectId', 'title', 'overview', 'objective', 'acceptanceCriteria', 'status', 'priority', 'requestedBy', 'requestedDate', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.overview is string && data.overview.size() < 2000 &&
             data.objective is string && data.objective.size() < 2000 &&
             data.acceptanceCriteria is string && data.acceptanceCriteria.size() < 5000 &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED', 'IMPLEMENTED'] &&
             data.priority in ['LOW', 'MEDIUM', 'HIGH'] &&
             data.requestedBy is string &&
             data.requestedDate is string &&
             data.createdAt is number &&
             data.updatedAt is number;
    }

    function isValidIssueLogItem(data) {
      return data.keys().hasAll(['id', 'projectId', 'title', 'description', 'priority', 'status', 'owner', 'reportedBy', 'reportedDate', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.description is string && data.description.size() < 2000 &&
             data.priority in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'] &&
             data.status in ['OPEN', 'IN_PROGRESS', 'RESOLVED', 'CLOSED'] &&
             data.owner is string &&
             data.reportedBy is string &&
             data.reportedDate is string &&
             (!('resolution' in data) || (data.resolution is string && data.resolution.size() < 2000)) &&
             data.createdAt is number &&
             data.updatedAt is number;
    }

    function isValidResource(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.role is string && data.role.size() < 100 &&
             (!('email' in data) || (data.email is string && data.email.size() < 100)) &&
             (!('department' in data) || (data.department is string && data.department.size() < 100)) &&
             (!('skills' in data) || (data.skills is list && data.skills.size() < 50)) &&
             (!('availability' in data) || (data.availability is number && data.availability >= 0 && data.availability <= 100)) &&
             (!('projectIds' in data) || (data.projectIds is list && data.projectIds.size() < 100)) &&
             data.createdAt is number &&
             data.updatedAt is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId) && 
                      request.resource.data.role == 'user';
      allow update: if isAdmin() || 
                      (isOwner(userId) && request.resource.data.role == resource.data.role);
    }

    match /resources/{resourceId} {
      allow read: if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isAuthenticated() && isValidResource(request.resource.data) && 
                      request.resource.data.ownerId == request.auth.uid;
      allow update: if (isOwner(resource.data.ownerId) || isAdmin()) && 
                      isValidResource(request.resource.data) &&
                      request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    match /projects/{projectId} {
      allow read: if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isAuthenticated() && isValidProject(request.resource.data);
      allow update: if (isOwner(resource.data.ownerId) || isAdmin()) && 
                      isValidProject(request.resource.data) &&
                      (isAdmin() || request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();

      match /tasks/{taskId} {
        allow read: if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) && isValidTask(request.resource.data);
        allow update: if isProjectOwner(projectId) && isValidTask(request.resource.data);
        allow delete: if isProjectOwner(projectId);
      }

      match /raidItems/{raidItemId} {
        allow read: if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) && isValidRAIDItem(request.resource.data);
        allow update: if isProjectOwner(projectId) && isValidRAIDItem(request.resource.data);
        allow delete: if isProjectOwner(projectId);
      }

      match /milestones/{milestoneId} {
        allow read: if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) && isValidMilestone(request.resource.data);
        allow update: if isProjectOwner(projectId) && isValidMilestone(request.resource.data);
        allow delete: if isProjectOwner(projectId);
      }

      match /phases/{phaseId} {
        allow read: if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) && isValidPhase(request.resource.data);
        allow update: if isProjectOwner(projectId) && isValidPhase(request.resource.data);
        allow delete: if isProjectOwner(projectId);
      }

      match /sprints/{sprintId} {
        allow read: if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) && isValidSprint(request.resource.data);
        allow update: if isProjectOwner(projectId) && isValidSprint(request.resource.data);
        allow delete: if isProjectOwner(projectId);
      }

      match /designDocs/{docId} {
        allow read: if isProjectOwner(projectId);
        allow create, update: if isProjectOwner(projectId) && isValidDesignDoc(request.resource.data);
        allow delete: if isProjectOwner(projectId);
      }

      match /files/{fileId} {
        allow read: if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) && isValidProjectFile(request.resource.data);
        allow delete: if isProjectOwner(projectId);
      }

      match /changeRequests/{requestId} {
        allow read: if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) && isValidChangeRequest(request.resource.data);
        allow update: if isProjectOwner(projectId) && isValidChangeRequest(request.resource.data);
        allow delete: if isProjectOwner(projectId);
      }

      match /issueLogItems/{itemId} {
        allow read: if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) && isValidIssueLogItem(request.resource.data);
        allow update: if isProjectOwner(projectId) && isValidIssueLogItem(request.resource.data);
        allow delete: if isProjectOwner(projectId);
      }
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
